condition texture notch_count
if({:condition};
    concat_st(
        {$sidebar^{:offset}};
        {$pan@-13};
        if(gte({:notch_count}; 1); {$notch^{:offset+3}}; {$pan@11});
        {$pan@-11};
        if(gte({:notch_count}; 2); {$notch^{:offset+7}}; {$pan@11});
        {$pan@-11};
        if(gte({:notch_count}; 3); {$notch^{:offset+11}}; {$pan@11});
        {$pan@-11};
        if(gte({:notch_count}; 4); {$notch^{:offset+15}}; {$pan@11});
        {$pan@-11};
        if(gte({:notch_count}; 5); {$notch^{:offset+19}}; {$pan@11});
        {$pan@-11};
        if(gte({:notch_count}; 6); {$notch^{:offset+23}}; {$pan@11});
        {$pan@-11};
        if(gte({:notch_count}; 7); {$notch^{:offset+27}}; {$pan@11});
        {$pan@-11};
        if(gte({:notch_count}; 8); {$notch^{:offset+31}}; {$pan@11});
        {$pan@-11};
        if(gte({:notch_count}; 9); {$notch^{:offset+35}}; {$pan@11});
        {$pan@-14}
    );
    concat_st(
        {${:texture}^{:offset}};
        {$pan@-16}
    )
)